      "userInfo": {
        "aiAgent": false,
        "xsecToken": "ABKX4G0tWAv3BKKxvRl0ZkT7tqgOAe1BfYHjbCa-n4mo4=",
        "userId": "658001c4000000001c01b88c",
        "nickname": "沐AuAu",
        "image": "https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31nqll3qa06005pc007273e4c06sni4g?imageView2/2/w/120/format/jpg"
      },
